{
  // ChronoRail Worker. Static site from ./dist (built by scripts/make-dist.sh); /api/* runs src/worker.js first.
  // Accounts stay OFF until AUTH_ENABLED is "1" and the secrets exist. Setup: docs/ACCOUNTS.md.
  "name": "chronorail",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AUTH_ENABLED": "1",
    "BASE_URL": "https://chronorail.si"
    // "MAIL_FROM": "signin@chronorail.si"   // only once Email Sending is on (Workers Paid) and the domain is onboarded
  },
  "d1_databases": [
    // D1 chronorail-accounts, created 2026-11-18; schema applied from migrations/0001_auth.sql via the dashboard console
    { "binding": "DB", "database_name": "chronorail-accounts", "database_id": "44bbb4a5-4973-4ead-b7f5-bad52d540e39", "migrations_dir": "migrations" }
  ],
  // Nightly stats → Notion "ChronoRail Stats" at 10:23 UTC (3:23 am MT). Needs secret NOTION_TOKEN.
  "triggers": { "crons": ["23 10 * * *"] },
  // "send_email": [{ "name": "EMAIL" }],   // uncomment with MAIL_FROM when Email Sending is enabled
  // Secrets, set by Silas only (never in this file): BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, FEEDBACK_AGENT_TOKEN, NOTION_TOKEN
  // Required by `npx wrangler preview` (non-production branch builds). Empty on purpose.
  "previews": {}
}
